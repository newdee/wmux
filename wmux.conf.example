# Example wmux configuration. Copy to %USERPROFILE%\.wmux.conf and edit.
# Syntax is the tmux subset: one command per line, '#' starts a comment.

# Prefix key (default C-b).
set -g prefix C-b

# Shell for new panes: pwsh (default), powershell, wsl, cmd, or an executable.
set -g default-shell pwsh
# Or a full command line (overrides default-shell):
# set -g default-command "wsl.exe -d Ubuntu --cd ~"

set -g mouse on
set -g history-limit 5000
set -g status-position bottom
set -g status-style fg=black,bg=green
set -g pane-border-style fg=brightblack
set -g pane-active-border-style fg=green
set -g base-index 0
set -g display-time 1500

# vim-style pane movement (h/j/k/l move, H/J/K/L resize) is the default;
# `prefix Tab` is last-window. Put `bind l last-window` here to get tmux's l back.

# easier splits
bind | split-window -h
bind - split-window -v

# window switching without the prefix
bind -n M-Left previous-window
bind -n M-Right next-window

# a WSL window on demand
bind W new-window -n wsl wsl.exe

# reload this file
bind r source-file ~/.wmux.conf

# status line formats (tmux syntax; #() runs every status-interval seconds)
set -g status-left "#[bold][#S] "
set -g status-right "#[fg=yellow]#(pwsh -NoProfile -Command (Get-Date).ToString('HH:mm'))#[default] #H"
set -g status-interval 15

# tell me about the windows I am not looking at: # output, ! bell, ~ silence
set -g monitor-activity on
set -g monitor-bell on
# set -g monitor-silence 60       # flag a window that has said nothing for 60s
# set -g visual-bell on           # status-line message instead of a real bell
# prefix M-n / M-p walk to the next window with a flag.

# keep a pane whose program exited, so a job that died leaves its output
# set -g remain-on-exit on

# resume after a reboot: sessions autosave; `wmux resume [name]` brings them back
set -g autosave on
set -g save-history 500           # lines of each pane restored with the session
# set -g restore-on-start on      # a fresh server restores everything by itself
# set -g sessions-dir ~/.wmux/sessions

# plugins: directories under plugin-path holding <name>.wmux
# set -g plugin-path ~/.wmux/plugins
# set -g @plugin agent-status
