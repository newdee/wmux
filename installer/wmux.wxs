<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-machine MSI for wmux: one directory under Program Files, wmux.exe on the
  system PATH, and a normal entry in "Apps & features".

  Build (WiX 3.14):
    candle -arch x64 -dVersion=<x.y.z> -dSourceDir=<dir with wmux.exe> installer\wmux.wxs -o <obj>
    light -ext WixUIExtension <obj> -o wmux-<x.y.z>-x86_64.msi
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="wmux"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="newdee"
           UpgradeCode="6C4E1E4B-0E0B-4E4E-9C2E-2B6B0B2F6A31">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="wmux $(var.Version) - a tmux-style terminal multiplexer for Windows" />

    <!-- Installing a newer version replaces the old one in place. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of wmux is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="wmux.exe" SourceFile="$(var.SourceDir)\wmux.exe" />
    <Property Id="ARPPRODUCTICON" Value="wmux.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/newdee/wmux" />

    <Feature Id="Main" Title="wmux" Level="1">
      <ComponentGroupRef Id="Files" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="wmux" />
      </Directory>
    </Directory>

    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Id="Exe" Guid="*" Win64="yes">
        <File Id="wmuxExe" Name="wmux.exe" Source="$(var.SourceDir)\wmux.exe" KeyPath="yes" />
        <!-- `wmux` works from any shell; removed again on uninstall. -->
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
      </Component>
      <!-- One file per component: an auto GUID needs a single unversioned file. -->
      <Component Id="Readme" Guid="*" Win64="yes">
        <File Id="ReadmeFile" Name="README.md" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="License" Guid="*" Win64="yes">
        <File Id="LicenseFile" Name="LICENSE" Source="$(var.SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="ConfExample" Guid="*" Win64="yes">
        <File Id="ConfExampleFile" Name="wmux.conf.example" Source="$(var.SourceDir)\wmux.conf.example" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />
    <UIRef Id="WixUI_InstallDir" />
  </Product>
</Wix>
